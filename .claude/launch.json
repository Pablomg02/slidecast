{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "syncdeck-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "bin/syncdeck.js",
        "serve",
        "examples/demo"
      ],
      "port": 4321
    },
    {
      "name": "syncdeck-network",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "bin/syncdeck.js",
        "serve",
        "examples/demo",
        "--host",
        "0.0.0.0"
      ],
      "port": 4321
    }
  ]
}

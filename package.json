{
  "name": "slidecast",
  "version": "0.1.0",
  "description": "Present any HTML slide deck, including AI-generated ones, with a presenter view, speaker notes, a phone remote and audience screens that follow live.",
  "type": "module",
  "license": "MIT",
  "author": "Pablo Magariños Docampo (https://github.com/Pablomg02)",
  "homepage": "https://github.com/Pablomg02/slidecast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pablomg02/slidecast.git"
  },
  "bugs": {
    "url": "https://github.com/Pablomg02/slidecast/issues"
  },
  "keywords": [
    "presentation",
    "slides",
    "presenter-view",
    "speaker-notes",
    "html",
    "websocket",
    "remote-control",
    "audience-view",
    "ai-generated"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "slidecast": "bin/slidecast.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "examples/"
  ],
  "scripts": {
    "start": "node bin/slidecast.js serve",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');const w=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?w(p.join(d,e.name)):e.name.endsWith('.js')?[p.join(d,e.name)]:[]);for(const f of ['bin','src','public'].flatMap(w))cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "site": "node site/build.js --serve",
    "site:build": "node site/build.js",
    "site:video": "node site/video/record.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fflate": "^0.8.3",
    "ws": "^8.22.0"
  }
}

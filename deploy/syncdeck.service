# systemd unit for syncdeck on a Raspberry Pi (or any Linux host).
# Install: see docs/deploy-raspberry.md, option B.
[Unit]
Description=syncdeck presentation server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syncdeck
Group=syncdeck
WorkingDirectory=/opt/syncdeck
Environment=NODE_ENV=production
Environment=SYNCDECK_HOST=127.0.0.1
Environment=SYNCDECK_PORT=4321
Environment=SYNCDECK_DATA=/var/lib/syncdeck/decks
Environment=SYNCDECK_STATE=/var/lib/syncdeck/state
ExecStart=/usr/bin/node /opt/syncdeck/bin/syncdeck.js serve --trust-proxy
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/syncdeck/decks /var/lib/syncdeck/state

[Install]
WantedBy=multi-user.target
